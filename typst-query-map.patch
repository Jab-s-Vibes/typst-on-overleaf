+/// Walk the document layout and emit one record per text run:
+/// `path|line|col|page|x|y|w|h` (positions in pt, top-left origin).
+fn source_map(world: &dyn World, doc: &PagedDocument) -> StrResult<String> {
+    let mut out = Vec::new();
+    for (i, page) in doc.pages().iter().enumerate() {
+        walk_frame(world, &page.frame, i + 1, 0.0, 0.0, &mut out);
+    }
+    Ok(out.join("\n"))
+}
+
+fn walk_frame(
+    world: &dyn World,
+    frame: &Frame,
+    page_no: usize,
+    ox: f64,
+    oy: f64,
+    out: &mut Vec<String>,
+) {
+    for (point, item) in frame.items() {
+        let x = ox + point.x.to_pt();
+        let y = oy + point.y.to_pt();
+        match item {
+            FrameItem::Group(group) => walk_frame(world, &group.frame, page_no, x, y, out),
+            FrameItem::Text(text) => {
+                let size = text.size.to_pt();
+                let w: f64 = text
+                    .glyphs
+                    .iter()
+                    .map(|g| g.x_advance.at(text.size).to_pt())
+                    .sum();
+                if w <= 0.0 {
+                    continue;
+                }
+                let Some(span) = text.glyphs.first().map(|g| g.span.0) else {
+                    continue;
+                };
+                let Some(id) = span.id() else { continue };
+                let Ok(src) = world.source(id) else { continue };
+                let Some(range) = world.range(span) else { continue };
+                let text = src.text();
+                let offset = range.start.min(text.len());
+                let before = &text[..offset];
+                let line = before.bytes().filter(|&b| b == b'\n').count() + 1;
+                let col = offset - before.rfind('\n').map(|i| i + 1).unwrap_or(0);
+                out.push(format!(
+                    "{}|{}|{}|{}|{:.1}|{:.1}|{:.1}|{:.1}",
+                    src.id().vpath().as_rooted_path().display(),
+                    line,
+                    col,
+                    page_no,
+                    x,
+                    y,
+                    w,
+                    size
+                ));
+            }
+            _ => {}
+        }
+    }
+}
